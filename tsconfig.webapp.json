{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "webapp",
    "outDir": "public",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["webapp/**/*.ts"],
  "exclude": ["node_modules", "plugin", "public"]
}
